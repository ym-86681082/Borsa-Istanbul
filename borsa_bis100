def baslangic_islemleri():
    try:
        global num
        conn = sqlite3.connect(borsa_veritabani_yeri)
        cur = conn.cursor()
        fromdate = basla_date
        cur.execute("SELECT name FROM sqlite_master WHERE type = 'table'")
        # SQLITE_MASTER tablosunu sorgulayarak tablo ve şema listesini alabilirsiniz
        tablolar = cur.fetchall()   # bir sorgu sonucunun tüm satırlarını getirir.
        # print(tablolar)   # 2 -----
        if len(tablolar) == 0 or ("bultenverileri" not in tablolar[0]):
            print("1 -Başlangıç Tarihi:", fromdate)   # 3 -----
            num = 1
            df, status = veri_al(fromdate)
            # ---kolon_isimlerini_degistir(df)
            df.to_sql("bultenverileri", conn, if_exists="append", index=False)
            cur.execute("create table 'alinan_veriler' (tarih date, durum integer)")
            date = (str(fromdate), 1)
            cur.execute("insert into 'alinan_veriler' (tarih, durum) values (?,?)", date)
            conn.commit()
        cur.execute("select tarih from 'alinan_veriler'")
        alinmis_veriler = cur.fetchall()   # bir sorgu sonucunun tüm satırlarını getirir.
        # print('alinmis_veriler-------------', alinmis_veriler)
        return conn, cur, alinmis_veriler
    except sqlite3.Error as error:
        print("Tablodan veri okunamadı-baslangic_islemleri", error)
        input('HATA... Çıkmak için Enter Yapın.')
        cur.close()
        if conn:
            conn.close()
        sys.exit()


def sontarih_al():
    try:
        conn = sqlite3.connect(borsa_veritabani_yeri)
        cur = conn.cursor()
        cur.execute('select Tarih from alinan_veriler')
        sontarih = cur.fetchall()[-1]
        sontarih =str(sontarih)[2:-3]
        """sontarih = str(sontarih)
        sontarih = sontarih.replace("('", "")
        sontarih = sontarih.replace("',)", "")  """
        # sontarih = cur.execute('select Tarih from alinan_veriler').fetchall()[-1]
        # sontarih = cur.execute("select tarih from 'alinan_veriler' order by tarih desc limit 1")
        sontarih = datetime.datetime.strptime(sontarih, '%Y-%m-%d').date()
        # print(sontarih, ' -----------------------')
        cur.close()
        conn.close()
        return sontarih
    except sqlite3.Error as error:
        print("Tablodan son tarih alınamadı-sontarih_al", error)
        input('HATA... Çıkmak için Enter Yapın.')
        cur.close()
        if conn:
            conn.close()
        sys.exit()


